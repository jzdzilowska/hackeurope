# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# planning docs (local only)
.planning/

# env files
.env*
!.env.local.example

# python
__pycache__/
venv/

# supabase
supabase/.temp/

# zapier credentials
.zapier_client.json
.zapier_tokens.json

# email agent runtime output
email_integration/output/
email_integration/logs/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
